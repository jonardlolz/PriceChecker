# Price Checker settings
# Copy this file to `.env` and fill in the values. Never commit `.env`.
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env

# Admin login password (required — choose a strong one)
ADMIN_PASSWORD=change-me

# Signs admin login tokens so sessions survive restarts.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# 127.0.0.1 = only reachable through Cloudflare Tunnel / dev proxy (recommended)
# 0.0.0.0   = also reachable from your local network at http://<computer-ip>:3000
HOST=127.0.0.1
PORT=3000

# Currency for price display (ISO 4217), e.g. USD, PHP, EUR
CURRENCY=USD

# Optional: database file location (default: data/pricechecker.db)
# DB_PATH=data/pricechecker.db

# Cloudflare Tunnel token for the public HTTPS address (secret).
# Get it with:  cloudflared tunnel token <tunnel-name>
# or from the Cloudflare dashboard: Zero Trust → Networks → Tunnels → your tunnel.
# Leave empty if you don't use `npm run live` / `npm run tunnel`.
TUNNEL_TOKEN=
