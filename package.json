{
  "name": "price-checker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --env-file-if-exists=.env --watch server.js\" \"vite\"",
    "dev:mobile": "concurrently -n api,web -c blue,green \"node --env-file-if-exists=.env --watch server.js\" \"vite --mode mobile\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server.js",
    "tunnel": "node scripts/tunnel.js",
    "live": "npm run build && concurrently -k -n app,tunnel -c blue,magenta \"npm start\" \"npm run tunnel\""
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
