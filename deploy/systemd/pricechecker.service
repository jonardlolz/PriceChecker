# Price Checker web app (production). Installed by deploy/setup.sh into ~/.config/systemd/user/
#   status:  systemctl --user status pricechecker
#   logs:    journalctl --user -u pricechecker -f
[Unit]
Description=Price Checker app
After=network-online.target

[Service]
WorkingDirectory=%h/price-checker/current
Environment=NODE_ENV=production
Environment=DB_PATH=%h/price-checker/shared/data/pricechecker.db
ExecStart=%h/price-checker/bin/node --env-file-if-exists=.env server.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
